    "cnet_crypto_qualification": {
      "kind": "static",
      "testOnly": true,
      "when": {
        "os": [
          "windows",
          "linux",
          "macos"
        ],
        "native": true
      },
      "sources": {
        "files": [
          "../../src/cnet_client_pool.c",
          "../../src/cnet_client.c",
          "../../src/cnet_command.c",
          "../../src/cnet_datagram.c",
          "../../src/cnet_destination_policy.c",
          "../../src/cnet_dispatcher.c",
          "../../src/cnet_dtls.c",
          "../../src/cnet_event.c",
          "../../src/cnet_handoff.c",
          "../../src/cnet_ipc.c",
          "../../src/cnet_kcp_fec.c",
          "../../src/cnet_kcp_secure.c",
          "../../src/cnet_kcp.c",
          "../../src/cnet_listener.c",
          "../../src/cnet_managed_dial.c",
          "../../src/cnet_manager.c",
          "../../src/cnet_module.c",
          "../../src/cnet_owner_strategy.c",
          "../../src/cnet_owner.c",
          "../../src/cnet_packet_endpoint.c",
          "../../src/cnet_recovery_policy.c",
          "../../src/cnet_resolver.c",
          "../../src/cnet_resources.c",
          "../../src/cnet_secure_kcp.c",
          "../../src/cnet_session.c",
          "../../src/cnet_sg_host.c",
          "../../src/cnet_shards.c",
          "../../src/cnet_transport.c",
          "../../src/cnet_uri.c",
          "../../src/cnet_websocket.c",
          "../../src/cnet_write_queue.c",
          "../../src/cnet_tls_crypto_qualification.c",
          "cnet_crypto_owner_admission.c",
          "public_context.c"
        ]
      },
      "private": {
        "includeDirs": [
          "../../include",
          "../../src",
          "."
        ],
        "deps": [
          "saltscore_wsparser",
          "saltsbase_core",
          "saltsbase_native_io",
          "saltsbase_uri",
          "saltsbase_simd",
          "saltsbase_asn1",
          "salts_crypto",
          "monocypher",
          "reed",
          "c-ares",
          "kcp"
        ]
      },
      "variants": [
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": [
              "/experimental:c11atomics"
            ]
          }
        },
        {
          "when": {
            "driver": [
              "clang",
              "gcc",
              "llvm-mingw"
            ]
          },
          "private": {
            "flags": [
              "-Werror=implicit-function-declaration",
              "-Werror=incompatible-pointer-types",
              "-Werror=return-type"
            ]
          }
        },
        {
          "when": {
            "os": "linux"
          },
          "private": {
            "defines": {
              "_DEFAULT_SOURCE": "1",
              "_POSIX_C_SOURCE": "200809L"
            }
          }
        },
        {
          "when": {
            "os": "macos"
          },
          "private": {
            "defines": {
              "_DARWIN_C_SOURCE": "1"
            }
          }
        }
      ]
    },
