{
  "targets": {
    "saltscore.cnet_crypto_static_original_owner_tls12_tls13": {
      "kind": "header_only",
      "when": {
        "os": [
          "windows",
          "linux",
          "macos"
        ],
        "native": true
      },
      "runtimeDeps": [
        "cnet_crypto_static_original_owner"
      ],
      "test": {
        "program": "${artifact:cnet_crypto_static_original_owner}",
        "timeout": 120,
        "labels": [
          "cnet",
          "integration"
        ]
      }
    },
    "saltscore.cnet_crypto_static_original_owner_go_mtls": {
      "kind": "header_only",
      "when": {
        "os": [
          "windows",
          "linux",
          "macos"
        ],
        "native": true
      },
      "runtimeDeps": [
        "cnet_crypto_static_original_owner"
      ],
      "test": {
        "tool": "go",
        "args": [
          "./e2e",
          "-timeout=340s",
          "-run",
          "^TestPrivateRequiredMTLS$",
          "-args",
          "-private-native",
          "${artifact:cnet_crypto_static_original_owner}"
        ],
        "workingDirectory": "$root/cnet/tests/independent/tls",
        "timeout": 360,
        "environment": [
          "CGO_ENABLED=0",
          "GOWORK=off"
        ],
        "labels": [
          "cnet",
          "interop"
        ]
      }
    },
