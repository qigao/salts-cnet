    "cnet_tls_ca_san_test": {
      "kind": "executable",
      "when": {
        "config": [
          "tests",
          "benchmark"
        ]
      },
      "sources": {
        "files": [
          "test_cnet_tls_ca_san.c"
        ]
      },
      "private": {
        "includeDirs": [
          "../src",
          "../../crypto/src",
          "../../crypto/tests/tls"
        ],
        "deps": [
          "cnet",
          "salts_crypto",
          "saltsbase_core",
          "saltsbase_native_io",
          "saltsbase_tinytest"
        ],
        "defines": {
          "SALTSCORE_EXPECT_PROVIDER_COPIES": "0",
          "CORE_TLS_TEST_P384_CA": "\"$root/crypto/tests/fixtures/p384-test-root-cert.pem\"",
          "CORE_TLS_TEST_P384_WRONG_CA": "\"$root/crypto/tests/fixtures/p384-test-wrong-root-cert.pem\"",
          "CORE_TLS_TEST_P384_LEAF": "\"$root/crypto/tests/fixtures/p384-test-server-cert.pem\"",
          "CORE_TLS_TEST_P384_KEY": "\"$root/crypto/tests/fixtures/p384-test-server-key.pem\"",
          "CORE_TLS_TEST_EXTERNAL_CA": "\"$root/crypto/tests/fixtures/external-io-ca-cert.pem\""
        }
      },
      "variants": [
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": [
              "/experimental:c11atomics"
            ]
          }
        }
      ],
      "test": {
        "name": "saltscore.cnet_tls_ca_san",
        "labels": [
          "cnet",
          "tls"
        ],
        "timeout": 65
      }
    },
    "saltscore_runtime_owner_probe": {
