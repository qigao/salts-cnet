{
  "targets": {
    "saltscore.two_cnet_plugins": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["saltscore_two_plugins_test", "saltscore_runtime_plugin_a", "saltscore_runtime_plugin_b"],
      "test": {
        "program": "${artifact:saltscore_two_plugins_test}",
        "args": ["${artifact:saltscore_runtime_plugin_a}", "${artifact:saltscore_runtime_plugin_b}"],
        "timeout": 30,
        "labels": ["cnet", "integration"]
      }
    },
    "saltscore.cnet_production_required_mtls": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true,
        "config": "tests"
      },
      "runtimeDeps": ["cnet_tls_ca_san_test"],
      "test": {
        "tool": "go",
        "args": ["./e2e", "-timeout=160s", "-run", "^TestRequiredMTLS$", "-args", "-native", "${artifact:cnet_tls_ca_san_test}"],
        "workingDirectory": "$root/cnet/tests/independent/tls",
        "timeout": 180,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["cnet", "interop"]
      }
    },
