{
  "version": 6,
  "include": [
    "../CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "vcpkg-cache",
      "hidden": true,
      "environment": {
        "VCPKG_INSTALLED_DIR": "$penv{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "$penv{VCPKG_TARGET_TRIPLET}",
        "SALTS_BASE_ROOT": "$penv{SALTS_BASE_ROOT}"
      },
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
        "VCPKG_TARGET_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}",
        "CMAKE_INSTALL_PREFIX": "$env{INSTALL_PREFIX}"
      },
      "description": "Consume the explicit preinstalled vcpkg-cache SDK; configure runs no resolver or port build"
    },
    {
      "name": "llvm-mingw-native-environment",
      "hidden": true,
      "inherits": [
        "vcpkg-cache",
        "llvm-mingw-runtime"
      ],
      "environment": {
        "LLVM_MINGW_TARGET": "$penv{LLVM_MINGW_TARGET}"
      }
    },
    {
      "name": "msvc-environment",
      "hidden": true,
      "inherits": [
        "vcpkg-cache",
        "native-runtime"
      ],
      "environment": {
        "VCPKG_TARGET_TRIPLET": "$env{MSVC_TARGET_TRIPLET}",
        "INSTALL_PREFIX": "$env{MSVC_INSTALL_PREFIX}"
      }
    },
    {
      "name": "llvm-native-environment",
      "hidden": true,
      "inherits": [
        "vcpkg-cache",
        "native-runtime"
      ],
      "environment": {
        "VCPKG_TARGET_TRIPLET": "$env{LLVM_NATIVE_TARGET_TRIPLET}",
        "INSTALL_PREFIX": "$env{LLVM_NATIVE_INSTALL_PREFIX}"
      }
    },
    {
      "name": "gcc-environment",
      "hidden": true,
      "inherits": [
        "vcpkg-cache",
        "native-runtime"
      ],
      "environment": {
        "VCPKG_TARGET_TRIPLET": "$env{GCC_TARGET_TRIPLET}",
        "INSTALL_PREFIX": "$env{GCC_INSTALL_PREFIX}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{GCC_C_COMPILER}",
        "CMAKE_CXX_COMPILER": "$env{GCC_CXX_COMPILER}"
      }
    },
    {
      "name": "llvm-mingw-x64-environment",
      "hidden": true,
      "inherits": [
        "vcpkg-cache",
        "llvm-mingw-runtime"
      ],
      "environment": {
        "INSTALL_PREFIX": "$env{LLVM_MINGW_X64_INSTALL_PREFIX}"
      }
    },
    {
      "name": "llvm-mingw-arm64-environment",
      "hidden": true,
      "inherits": [
        "vcpkg-cache",
        "llvm-mingw-runtime"
      ],
      "environment": {
        "INSTALL_PREFIX": "$env{LLVM_MINGW_ARM64_INSTALL_PREFIX}"
      }
    },
    {
      "name": "android-toolchain-environment",
      "hidden": true,
      "inherits": "vcpkg-cache"
    },
    {
      "name": "android-environment",
      "hidden": true,
      "inherits": "android-toolchain-environment",
      "environment": {
        "VCPKG_TARGET_TRIPLET": "$env{ANDROID_TARGET_TRIPLET}",
        "INSTALL_PREFIX": "$env{ANDROID_INSTALL_PREFIX}"
      }
    },
    {
      "name": "android-arm64-environment",
      "hidden": true,
      "inherits": [
        "android-toolchain-environment"
      ],
      "environment": {
        "INSTALL_PREFIX": "$env{ANDROID_ARM64_INSTALL_PREFIX}"
      }
    },
    {
      "name": "android-x64-environment",
      "hidden": true,
      "inherits": [
        "android-toolchain-environment"
      ],
      "environment": {
        "INSTALL_PREFIX": "$env{ANDROID_X64_INSTALL_PREFIX}"
      }
    },
    {
      "name": "llvm-mingw-runtime",
      "hidden": true,
      "inherits": "native-runtime",
      "environment": {
        "LLVM_MINGW_ROOT": "$penv{LLVM_MINGW_ROOT}",
        "PATH": "${sourceDir}/build/${presetName}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{VCPKG_TARGET_TRIPLET}/$env{VCPKG_CONFIGURATION_SUBDIR}bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/$env{VCPKG_TARGET_TRIPLET}/bin${pathListSep}$env{SALTS_BASE_ROOT}/bin${pathListSep}$env{LLVM_MINGW_ROOT}/$env{LLVM_MINGW_TARGET}/bin${pathListSep}$env{LLVM_MINGW_ROOT}/bin${pathListSep}$penv{PATH}"
      }
    }
  ]
}
