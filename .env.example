# Copy to .env and supply literal absolute paths (prefer forward slashes).
# CMake does not load .env. Load it in your shell; never commit credentials.

# Checkout qigao/vcpkg-cache at v0.1.2. Restore the selected lock as in README.md.
# This checkout supplies the restore script; CMake consumes only the SDK root.
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/vcpkg-cache
VCPKG_INSTALLED_DIR=C:/path/to/restored/payload/vcpkg_installed
VCPKG_TARGET_TRIPLET=qigao-x64-windows-llvm-mingw

# Matching released SaltsBase SDK (0.1.0 or newer), including SIMD and NativeIO.
SALTS_BASE_ROOT=C:/path/to/salts-base-sdk

# Windows LLVM-MinGW: compiler and dependencies are separate preinstalled SDKs.
LLVM_MINGW_ROOT=C:/path/to/llvm-mingw
LLVM_MINGW_TARGET=x86_64-w64-mingw32
VSDEVCMD_BAT=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
INSTALL_PREFIX=C:/path/to/salts-core/release
CMAKE_BUILD_PARALLEL_LEVEL=2

# Explicit Windows target profiles (select a matching dependency/Base SDK).
# LLVM_MINGW_X64_INSTALL_PREFIX=C:/path/to/salts-core/llvm-mingw/x64/release
# LLVM_MINGW_ARM64_INSTALL_PREFIX=C:/path/to/salts-core/llvm-mingw/arm64/release

# MSVC: use the x64-windows dependency lock and MSVC SaltsBase SDK.
# MSVC_TARGET_TRIPLET=x64-windows
# MSVC_INSTALL_PREFIX=C:/path/to/salts-core/msvc/release

# POSIX LLVM: clang/clang++ on PATH. Sanitizers instrument this graph, not Base.
# LLVM_NATIVE_TARGET_TRIPLET=x64-linux
# LLVM_NATIVE_INSTALL_PREFIX=/path/to/salts-core/llvm-native/release

# Linux/macOS GNU profiles: explicit compiler paths and matching SDKs.
# GCC_C_COMPILER=/usr/bin/gcc
# GCC_CXX_COMPILER=/usr/bin/g++
# GCC_TARGET_TRIPLET=x64-linux
# GCC_INSTALL_PREFIX=/path/to/salts-core/gcc/release

# Android uses CMake's NDK support; no vcpkg or generated toolchain is selected.
# ANDROID_NDK_HOME=C:/path/to/android-ndk
# ANDROID_ARM64_INSTALL_PREFIX=C:/path/to/salts-core/android/arm64-v8a/release
# ANDROID_X64_INSTALL_PREFIX=C:/path/to/salts-core/android/x86_64/release
# Parameterized android-release-user profile:
# SALTSCORE_ANDROID_ABI=arm64-v8a
# ANDROID_TARGET_TRIPLET=arm64-android
# ANDROID_INSTALL_PREFIX=C:/path/to/salts-core/android/arm64-v8a/release
