# Copy to .env and fill the paths for the selected toolkit (see README.md).
# Values are literal absolute paths; prefer forward slashes. No expansion.
# .env overrides the parent environment. Never commit it or credentials.

# Shared vcpkg infrastructure and an existing llvm-mingw toolchain.
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/vcpkg-cache
VCPKG_ROOT=C:/tools/vcpkg
VSDEVCMD_BAT=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
# Match the upstream setup output; prepend its bin directory to the parent PATH
# after loading .env, before invoking WithVs.cmd/CMake/CTest (see README.md).
LLVM_MINGW_ROOT=C:/path/to/llvm-mingw
LLVM_MINGW_PROJECT_TOOLCHAIN_FILE=C:/path/to/llvm-mingw/qigao-product-toolchain.cmake
LLVM_MINGW_DEPENDENCY_TOOLCHAIN_FILE=C:/path/to/llvm-mingw/qigao-toolchain.cmake
LLVM_MINGW_HOST_DEPENDENCY_TOOLCHAIN_FILE=C:/path/to/llvm-mingw/qigao-host-toolchain.cmake
VCPKG_TARGET_TRIPLET=qigao-x64-windows-llvm-mingw
VCPKG_HOST_TRIPLET=qigao-x64-windows-llvm-mingw
PKG_CONFIG=C:/path/to/native/pkgconf.exe

INSTALL_PREFIX=C:/path/to/salts-core/release
CMAKE_BUILD_PARALLEL_LEVEL=2

# Presets read cache policy from the parent environment on every runner.
# Local example: writable default cache and read-only shared NuGet feed.
# Replace the config path with this checkout's absolute path (literal value).
VCPKG_BINARY_SOURCES=clear;default,readwrite;nugettimeout,1800;nugetconfig,C:/path/to/salts-core/cmake/vcpkg-cache.nuget.config,read
# CI setup may instead supply its curl/files policy through the same variable.
# Supply GITHUB_TOKEN with read:packages in .env or the parent environment.
# Never store a token in this example.
# GITHUB_TOKEN=

# Target-specific profiles share the host triplet and host dependency toolchain
# above. Project toolchains are independent of dependency/host toolchains.
# Populate the selected target's settings; each install prefix must be distinct.
# llvm-mingw-x64-release-user: the Qigao x64 triplet uses the host toolchain for ports.
# LLVM_MINGW_X64_PROJECT_TOOLCHAIN_FILE=C:/path/to/llvm-mingw-x64/qigao-product-toolchain.cmake
# LLVM_MINGW_X64_INSTALL_PREFIX=C:/path/to/salts-core/llvm-mingw/x64/release
# llvm-mingw-arm64-release-user: ARM64 ports use their own dependency toolchain.
# LLVM_MINGW_ARM64_PROJECT_TOOLCHAIN_FILE=C:/path/to/llvm-mingw-arm64/qigao-product-toolchain.cmake
# LLVM_MINGW_ARM64_DEPENDENCY_TOOLCHAIN_FILE=C:/path/to/llvm-mingw-arm64/qigao-toolchain.cmake
# LLVM_MINGW_ARM64_INSTALL_PREFIX=C:/path/to/salts-core/llvm-mingw/arm64/release

# android-arm64-release-user / android-x64-release-user share ANDROID_NDK_HOME
# and the same host configuration above. The ABI/triplet is fixed by the preset.
# ANDROID_NDK_HOME=C:/path/to/android-ndk
# ANDROID_ARM64_INSTALL_PREFIX=C:/path/to/salts-core/android/arm64-v8a/release
# ANDROID_X64_INSTALL_PREFIX=C:/path/to/salts-core/android/x86_64/release

# Optional MSVC profile: msvc-release-user. VsDevCmd selects compiler/SDK paths.
# MSVC_TARGET_TRIPLET=x64-windows
# MSVC_HOST_TRIPLET=x64-windows
# MSVC_INSTALL_PREFIX=C:/path/to/salts-core/msvc/release

# POSIX LLVM: llvm-native-release-user (Linux/macOS),
# llvm-native-asan-ubsan-user / llvm-native-tsan-user (Linux).
# All three profiles use the same inputs below; use an isolated install prefix
# for each build mode.
# Supply the actual toolchain produced by setup-llvm-native or your toolkit.
# LLVM_NATIVE_TOOLCHAIN_FILE=/path/to/native-llvm-toolchain.cmake
# LLVM_NATIVE_TARGET_TRIPLET=x64-linux
# LLVM_NATIVE_HOST_TRIPLET=x64-linux
# LLVM_NATIVE_INSTALL_PREFIX=/path/to/salts-core/llvm-native/release

# Optional Linux GNU profile: gcc-release-user. Use matching compiler/triplets.
# GCC_C_COMPILER=/usr/bin/gcc
# GCC_CXX_COMPILER=/usr/bin/g++
# GCC_TARGET_TRIPLET=x64-linux
# GCC_HOST_TRIPLET=x64-linux
# GCC_INSTALL_PREFIX=/path/to/salts-core/gcc/release
# macos-gcc-release-user uses the same GCC_* inputs with macOS compiler paths,
# x64-osx or arm64-osx triplets and the matching installation prefix.

# Parameterized NDK profile: android-release-user. Pair ABI with its triplet.
# Keep each ABI's install prefix separate.
# SALTSCORE_ANDROID_ABI=arm64-v8a
# ANDROID_TARGET_TRIPLET=arm64-android
# ANDROID_HOST_TRIPLET=qigao-x64-windows-llvm-mingw
# ANDROID_INSTALL_PREFIX=C:/path/to/salts-core/android/arm64-v8a/release

# Released SaltsBase SDK, 0.1.0 or newer (Core, NativeIO, ASN1, URI, TinyTest).
SALTS_BASE_ROOT=C:/path/to/salts-base/release
