# Import these values in the parent environment before invoking CMake presets.
# Use absolute paths with forward slashes. CMake does not load .env itself.
VSDEVCMD_BAT=C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/Common7/Tools/VsDevCmd.bat
VCPKG_CACHE_REPOSITORY_ROOT=C:/path/to/vcpkg-cache
CMAKE_BUILD_PARALLEL_LEVEL=8

# Compiler executables and target metadata are selected by presets, without
# toolchain files. LLVM-MinGW requires only its compiler SDK root.
LLVM_MINGW_ROOT=C:/tools/llvm-mingw

# Windows ARM64 needs independently installed ARM64 SDKs; x64 roots are invalid.
# SaltsBase v0.1.3 does not publish a Windows ARM64 SDK.
# LLVM_MINGW_ARM64_SALTS_BASE_ROOT=C:/path/to/windows-arm64-salts-base-sdk
# LLVM_MINGW_ARM64_VCPKG_INSTALLED_DIR=C:/path/to/arm64-payload/vcpkg_installed
# LLVM_MINGW_ARM64_INSTALL_PREFIX=C:/path/to/salts-core/windows-arm64/release
# Android uses the preset ABI (or ANDROID_ABI) and native CMake NDK support.
# ANDROID_NDK_HOME=C:/path/to/android-ndk
# ANDROID_ABI=arm64-v8a

# Native Linux/macOS and generic Android profiles select the installed triplet.
# Named Windows/Android presets set their triplet directly.
# VCPKG_TARGET_TRIPLET=x64-linux
# Packages are consumed from build/<preset>/vcpkg_installed/<triplet>.
# Override VCPKG_INSTALLED_DIR in the consuming user preset environment if needed.

# Authenticated package restoration uses the shared feed. Never commit credentials.
# Configure consumes installed packages; it does not invoke vcpkg or port builds.
# GITHUB_TOKEN=

# Installation defaults to build/<preset>/stage; override with -D when needed.

# GitHub-hosted CI restores the locked preinstalled archive automatically.
# Direct local use of a ci-*-user preset selects a restored installation root:
# SALTS_CI_VCPKG_INSTALLED_DIR=C:/preinstalled/salts-base/msvc-release-user/vcpkg_installed

# Exact upstream release versions, without the v prefix.
# resolve-release requires the shared helper shipped after v0.1.2.
VCPKG_CACHE_VERSION=0.1.3
SALTS_BASE_VERSION=0.1.5
SALTS_BASE_ROOT=C:/path/to/salts-base-sdk
