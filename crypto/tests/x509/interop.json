{
  "targets": {
    "crypto.x509.sm2_ocsp_independent": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["crypto_sm2_ocsp_peer"],
      "test": {
        "tool": "go",
        "args": ["./e2e", "-timeout=90s", "-run", "^TestSM2OCSP$", "-args", "-ocsp-peer", "${artifact:crypto_sm2_ocsp_peer}"],
        "workingDirectory": "$root/crypto/tests/x509/independent",
        "timeout": 180,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto.x509.sm2_ocsp_delegation": {
      "kind": "header_only",
