{
  "targets": {
    "crypto.asn1.sm2_keys_independent": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["crypto_sm2_keys_peer", "crypto_pkcs12_peer"],
      "test": {
        "tool": "go",
        "args": ["-timeout=110s", "-run", "^TestSM2KeyInterop$", "-args", "-sm2-keys-peer", "${artifact:crypto_sm2_keys_peer}", "-pkcs12-peer", "${artifact:crypto_pkcs12_peer}"],
        "workingDirectory": "$root/crypto/tests/asn1/e2e",
        "timeout": 120,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto.asn1.pkcs12_independent": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["crypto_sm2_keys_peer", "crypto_pkcs12_peer"],
      "test": {
        "tool": "go",
        "args": ["-timeout=110s", "-run", "^TestPKCS12Interop$", "-args", "-sm2-keys-peer", "${artifact:crypto_sm2_keys_peer}", "-pkcs12-peer", "${artifact:crypto_pkcs12_peer}"],
        "workingDirectory": "$root/crypto/tests/asn1/e2e",
        "timeout": 120,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto_pkcs12_peer": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "sources": {
        "files": ["pkcs12_peer.c"]
      },
      "private": {
        "deps": ["salts_crypto", "saltsbase_asn1", "saltsbase_simd", "saltsbase_core"],
        "includeDirs": ["../../../include"]
      }
    },
    "crypto_sm2_keys_peer": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "sources": {
        "files": ["sm2_keys_peer.c"]
      },
      "private": {
        "deps": ["salts_crypto", "saltsbase_asn1", "saltsbase_simd", "saltsbase_core"],
        "includeDirs": ["../../../include"]
      }
    }
  }
}
