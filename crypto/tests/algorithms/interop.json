        "timeout": 120,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto_dtls_client_cases_test": {
      "kind": "executable",
      "testOnly": true,
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "sources": {
        "files": ["dtls_client_cases.c"]
      },
      "private": {
        "deps": ["salts_crypto", "saltsbase_tinytest", "gmssl", "saltsbase_asn1", "saltsbase_simd", "saltsbase_core"],
        "includeDirs": ["../../include"]
      },
      "variants": [
        {
          "when": {
            "driver": "msvc"
          },
          "private": {
            "flags": ["/experimental:c11atomics"]
          }
        }
      ]
    },
