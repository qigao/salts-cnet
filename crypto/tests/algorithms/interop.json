{
  "targets": {
    "crypto.algorithms.dtls_record": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["crypto_dtls_record_test"],
      "test": {
        "tool": "go",
        "args": ["./e2e", "-timeout=50s", "-run", "^TestDTLSRecordOracle$", "-args", "-record-suite", "${artifact:crypto_dtls_record_test}"],
        "workingDirectory": "$root/crypto/tests/algorithms/independent",
        "timeout": 60,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto.algorithms.dtls_handshake": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["crypto_dtls_handshake_test", "crypto_dtls_secrets_test", "crypto_dtls_exchange_test", "crypto_dtls_client_cases_test", "crypto_dtls_server_cases_test"],
      "test": {
        "tool": "go",
        "args": ["./e2e", "-timeout=100s", "-run", "^TestDTLSHandshakeOracle$", "-args", "-handshake-suite", "${artifact:crypto_dtls_handshake_test}", "-secrets-suite", "${artifact:crypto_dtls_secrets_test}", "-exchange-suite", "${artifact:crypto_dtls_exchange_test}", "-client-suite", "${artifact:crypto_dtls_client_cases_test}", "-server-suite", "${artifact:crypto_dtls_server_cases_test}"],
        "workingDirectory": "$root/crypto/tests/algorithms/independent",
        "timeout": 120,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto.algorithms.dtls_client_independent": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["crypto_dtls_client_endpoint"],
      "test": {
        "tool": "go",
        "args": ["./e2e", "-timeout=75s", "-run", "^TestScriptedDTLSClient$", "-args", "-dtls-client", "${artifact:crypto_dtls_client_endpoint}"],
        "workingDirectory": "$root/crypto/tests/algorithms/independent",
        "timeout": 90,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto.algorithms.dtls_server_independent": {
      "kind": "header_only",
