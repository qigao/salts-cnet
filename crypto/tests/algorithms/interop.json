        "tool": "go",
        "args": ["./e2e", "-timeout=75s", "-run", "^TestScriptedDTLSServer$", "-args", "-dtls-server", "${artifact:crypto_dtls_server_endpoint}"],
        "workingDirectory": "$root/crypto/tests/algorithms/independent",
        "timeout": 90,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
    "crypto.algorithms.dtls_client_pion": {
      "kind": "header_only",
      "when": {
        "os": ["windows", "linux", "macos"],
        "native": true
      },
      "runtimeDeps": ["crypto_dtls_client_endpoint"],
      "test": {
        "tool": "go",
        "args": ["./e2e", "-failfast", "-v", "-timeout=60s", "-run", "^TestDTLSClientAgainstPion$", "-args", "-dtls-client", "${artifact:crypto_dtls_client_endpoint}"],
        "workingDirectory": "$root/crypto/tests/algorithms/independent",
        "timeout": 120,
        "environment": ["CGO_ENABLED=0", "GOWORK=off"],
        "labels": ["crypto", "interop"]
      }
    },
